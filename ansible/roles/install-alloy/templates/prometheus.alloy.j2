// ============================================================
// Node Exporter
// ============================================================

prometheus.exporter.unix "node" {
{% if alloy_textfile_directory | default('') | length > 0 %}
  enable_collectors = ["systemd", "textfile"]
{% else %}
  enable_collectors = ["systemd"]
{% endif %}
  systemd {
    unit_include = {{ ('^(' ~ (alloy_systemd_units | map('regex_escape') | join('|')) ~ ')$') | tojson }}
  }
{% if alloy_textfile_directory | default('') | length > 0 %}
  textfile {
    directory = {{ alloy_textfile_directory | tojson }}
  }
{% endif %}
}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.relabel.add_common_labels.receiver]
}

// ============================================================
// Host Alloy self-metrics
// ============================================================

prometheus.exporter.self "host" {}

discovery.relabel "alloy_self" {
  targets = prometheus.exporter.self.host.targets
  rule {
    target_label = "job"
    replacement  = "alloy-host"
  }
}

prometheus.scrape "alloy_self" {
  targets         = discovery.relabel.alloy_self.output
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.add_common_labels.receiver]
}

// ============================================================
// System cAdvisor (system.slice only - k8s pods are NOT our responsibility)
// ============================================================

prometheus.exporter.cadvisor "system" {
  enabled_metrics        = ["cpu", "memory"]
  store_container_labels = true
}

prometheus.relabel "cadvisor_system_only" {
  forward_to = [prometheus.relabel.add_common_labels.receiver]

  rule {
    source_labels = ["id"]
    regex         = "/system\\.slice.*"
    action        = "keep"
  }
}

prometheus.scrape "cadvisor_system" {
  targets    = prometheus.exporter.cadvisor.system.targets
  forward_to = [prometheus.relabel.cadvisor_system_only.receiver]
}

{% if falco is defined and falco.enabled | default(false) %}
// ============================================================
// Falco
// ============================================================

prometheus.scrape "falco" {
  targets = [{
    __address__ = "{{ falco.metrics_address }}",
  }]
  metrics_path = "{{ falco.metrics_path }}"
  forward_to   = [prometheus.relabel.add_common_labels.receiver]
}
{% endif %}

{% for target in alloy_extra_scrape_targets | default([]) %}
// ============================================================
// {{ target.name }}
// ============================================================

prometheus.scrape {{ ('extra_' ~ target.name) | tojson }} {
  targets = [{
    __address__ = {{ target.address | tojson }},
  }]
  job_name     = {{ target.name | tojson }}
  metrics_path = {{ target.metrics_path | default('/metrics') | tojson }}
  forward_to   = [prometheus.relabel.add_common_labels.receiver]
}

{% endfor %}
// ============================================================
// Common labels for all metrics
// ============================================================

prometheus.relabel "add_common_labels" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster"
    replacement  = "{{ cluster }}"
  }
  rule {
    target_label = "hostname"
    replacement  = "{{ ansible_hostname }}"
  }
}

// ============================================================
// Remote Write
// ============================================================

prometheus.remote_write "mimir" {
  endpoint {
    url = "{{ mimir_endpoint }}"

    tls_config {
      cert_file = "{{ tls_cert_path }}"
      key_file = "{{ tls_key_path }}"
    }

    headers = {
      "X-Scope-OrgID" = "{{ mimir_org_id }}",
    }
  }
}
