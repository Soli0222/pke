{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'security:minimumReleaseAgeNpm',
  ],
  reviewers: [
    'Soli0222',
  ],
  assignees: [
    'Soli0222',
  ],
  timezone: 'Asia/Tokyo',
  prConcurrentLimit: 15,
  prHourlyLimit: 8,
  labels: [
    'dependencies',
  ],
  enabledManagers: [
    'ansible',
    'ansible-galaxy',
    'flux',
    'github-actions',
    'helmfile',
    'helm-requirements',
    'helm-values',
    'kubernetes',
    'custom.regex',
    'terraform',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)flux/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)flux/.+/cronjob-.+\\.ya?ml$/',
      '/(^|/)charts/.+/values\\.yaml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)charts/.+/values\\.yaml$/',
    ],
  },
  packageRules: [
    // Flux manager はクラスタの境界を区別せず、同名・同 namespace の
    // HelmRepository をすべて参照する。両クラスタで共通の chart は URL を1件に絞る。
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['alloy'],
      registryUrls: ['https://grafana.github.io/helm-charts'],
    },
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['cert-manager'],
      registryUrls: ['https://charts.jetstack.io'],
    },
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['cloudnative-pg', 'plugin-barman-cloud'],
      registryUrls: ['https://cloudnative-pg.github.io/charts'],
    },
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['external-dns'],
      registryUrls: ['https://kubernetes-sigs.github.io/external-dns/'],
    },
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['kube-state-metrics', 'prometheus-operator-crds'],
      registryUrls: ['https://prometheus-community.github.io/helm-charts'],
    },
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['longhorn'],
      registryUrls: ['https://charts.longhorn.io'],
    },
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['topolvm'],
      registryUrls: ['https://topolvm.github.io/topolvm'],
    },
    {
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchPackageNames: ['traefik'],
      registryUrls: ['https://traefik.github.io/charts'],
    },
    // DB image の更新は接続断と ALTER EXTENSION を伴うため、手動で反映する。
    {
      matchManagers: ['custom.regex'],
      matchDepNames: ['Soli0222/pgroonga-cnpg'],
      commitMessageTopic: 'PGroonga CNPG image',
      addLabels: ['manager:cnpg'],
      automerge: false,
    },
    {
      matchManagers: [
        'terraform',
      ],
      commitMessageTopic: 'Terraform {{depName}}',
      addLabels: [
        'manager:terraform',
      ],
    },
    {
      matchManagers: [
        'helmfile',
        'helm-requirements',
        'helm-values',
      ],
      commitMessageTopic: 'Helm chart {{depName}}',
      addLabels: [
        'manager:helm',
      ],
    },
    {
      matchManagers: [
        'flux',
      ],
      commitMessageTopic: 'Flux {{depName}}',
      addLabels: [
        'manager:flux',
      ],
    },
    {
      matchManagers: [
        'ansible',
        'ansible-galaxy',
      ],
      commitMessageTopic: 'Ansible {{depName}}',
      addLabels: [
        'manager:ansible',
      ],
    },
    {
      matchManagers: [
        'kubernetes',
      ],
      commitMessageTopic: 'Kubernetes image {{depName}}',
      addLabels: [
        'manager:kubernetes',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      commitMessageTopic: 'GitHub Action {{depName}}',
      addLabels: [
        'manager:github-actions',
      ],
      separateMinorPatch: true,
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'etcd-io/etcd',
        'k3s-io/k3s',
      ],
      commitMessageTopic: 'Ansible {{depName}}',
      addLabels: [
        'manager:ansible-vars',
      ],
    },
    // charts/ の第三者イメージ追従。helm-charts から移植。automerge はしない。
    {
      matchFileNames: [
        'charts/**',
      ],
      matchDatasources: [
        'docker',
      ],
      commitMessagePrefix: 'chore(chart):',
      addLabels: [
        'manager:charts',
      ],
      automerge: false,
    },
  ],
  // charts/ の image tag を上げたら同じ PR で chart version の patch を上げる。
  // GitRepository 参照でも HelmChart.spec.reconcileStrategy の既定は ChartVersion
  // なので、version が上がらないと新しい chart artifact が作られず反映されない。
  //
  // filePatterns は更新対象ファイルのディレクトリ基準なので、Chart.yaml を持たない
  // flux/ 以下の更新には一致せず影響しない。
  bumpVersions: [
    {
      filePatterns: [
        '{{packageFileDir}}/Chart.yaml',
      ],
      matchStrings: [
        '(?:^|\\n)version:\\s*(?<version>[^\\s]+)',
      ],
      bumpType: 'patch',
    },
  ],
  customManagers: [
    // PGroonga のバージョンが image repository のパスに含まれるため、
    // Docker tag (:18) ではなく公開済み GitHub Release を追跡する。
    // PostgreSQL major 18 の Alpine Release のみを対象にする。
    {
      customType: 'regex',
      managerFilePatterns: ['/^flux/clusters/.+/apps/.+/cluster\\.yaml$/'],
      matchStrings: [
        'imageName:\\s*ghcr\\.io/soli0222/pgroonga-cnpg/(?<currentValue>\\d+\\.\\d+\\.\\d+)-alpine:18(?:\\s|$)',
      ],
      depNameTemplate: 'Soli0222/pgroonga-cnpg',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
      extractVersionTemplate: '^(?<version>\\d+\\.\\d+\\.\\d+)-alpine-18$',
    },
    // charts/*/values.yaml の `repository:` + `tag:` の組。helm-values だけでは
    // 拾えない書き方を補う。helm-charts から移植。
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)charts/.+/values\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>[^\\s]+)\\s+tag:\\s*["\'](?<currentValue>[^"\']+)["\']',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    // charts/*/Chart.yaml の appVersion を `# renovate: image=...` で追従させる。
    // helm-charts から移植。
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)charts/.+/Chart\\.yaml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*image=(?<depName>[^\\s]+)\\nappVersion:\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/(?:inventories/group_vars|roles/.+/defaults)/.*\\.ya?ml$/',
      ],
      matchStrings: [
        'etcd_version:\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'etcd-io/etcd',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/(?:inventories/group_vars|roles/.+/defaults)/.*\\.ya?ml$/',
      ],
      matchStrings: [
        'k3s_version:\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'k3s-io/k3s',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
}
