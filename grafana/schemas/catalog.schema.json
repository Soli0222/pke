{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "datasources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "dashboards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^dashboards/.+\\.json$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "upstream",
                  "custom",
                  "existing"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "changes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "kind",
              "url",
              "revision",
              "license",
              "changes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "title",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "folders": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "title"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^dashboards/.+/_folder\\.json$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "datasources",
    "dashboards"
  ],
  "additionalProperties": false
}
