      {
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "description": "選択したインターフェースの現在値。欠測は正常として補完しない。",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "mappings": [
              {
                "options": {
                  "1": {
                    "color": "green",
                    "text": "up"
                  },
                  "2": {
                    "color": "red",
                    "text": "down"
                  },
                  "3": {
                    "color": "orange",
                    "text": "testing"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green"
                }
              ]
            },
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Oper"
              },
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-text"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Name"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 180
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Description"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 220
                }
              ]
            }
          ]
        },
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 8,
          "h": 8
        },
        "id": 7,
        "options": {
          "cellHeight": "sm",
          "footer": {
            "countRows": false,
            "fields": "",
            "reducer": [
              "sum"
            ],
            "show": false
          },
          "showHeader": true
        },
        "targets": [
          {
            "refId": "A",
            "expr": "ifOperStatus{cluster=\"meruto\",target=\"ccat-1\",ifName=~\"${interface:regex}\"}",
            "instant": true,
            "format": "table"
          }
        ],
        "title": "Interface operating status",
        "transformations": [
          {
            "id": "labelsToFields",
            "options": {
              "mode": "columns"
            }
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "cluster": true,
                "container": true,
                "endpoint": true,
                "instance": true,
                "job": true,
                "namespace": true,
                "pod": true,
                "service": true,
                "target": true
              },
              "renameByName": {
                "Value": "Oper",
                "Value #A": "Oper",
                "ifDescr": "Description",
                "ifIndex": "Index",
                "ifName": "Name"
              }
            }
          }
        ],
        "type": "table"
      },
