{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "ccat-1"
  },
  "spec": {
    "title": "CCAT-1",
    "description": "Cisco Catalystの機器リソース、全インターフェース、SNMP収集状態、syslogを確認する。Interfaceで表示対象を選択。",
    "schemaVersion": 42,
    "timezone": "browser",
    "refresh": "1m",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "tags": [
      "network",
      "snmp",
      "cisco",
      "pke"
    ],
    "editable": true,
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "description": "1=収集成功、0=失敗。120秒より古い系列は欠測として表示。",
        "fieldConfig": {
          "defaults": {
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green"
                }
              ]
            },
            "unit": "none",
            "noValue": "No data",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "id": 1,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "up{cluster=\"meruto\",target=\"ccat-1\"} and (time() - timestamp(up{cluster=\"meruto\",target=\"ccat-1\"}) < 120)",
            "legendFormat": "SNMP",
            "editorMode": "code",
            "format": "time_series",
            "instant": true,
            "range": false
          }
        ],
        "title": "SNMP collection",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
