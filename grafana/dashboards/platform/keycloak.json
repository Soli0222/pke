      {
        "id": 11,
        "title": "JVMヒープ",
        "description": "heap領域の使用量・確保済み容量・上限。max=-1の未定義poolは上限の合計から除く。",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(jvm_memory_used_bytes{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",area=\"heap\"})",
            "legendFormat": "Used",
