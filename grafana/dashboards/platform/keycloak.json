{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "pke-keycloak"
  },
  "spec": {
    "title": "PKE / Keycloak",
    "description": "KeycloakのHTTP・DCR/token・JVM・DBプールと認証拒否ログ。収集成功とログイン成功を区別する。HTTPは全realm合算。",
    "schemaVersion": 42,
    "editable": true,
    "timezone": "browser",
    "refresh": "1m",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "tags": [
      "pke",
      "keycloak",
      "authentication"
    ],
    "graphTooltip": 1,
    "templating": {
      "list": [
        {
          "name": "cluster",
          "label": "Cluster",
          "type": "custom",
          "query": "natsume",
          "current": {
            "text": "natsume",
            "value": "natsume"
          },
          "options": [
            {
              "text": "natsume",
              "value": "natsume",
              "selected": true
            }
          ],
          "multi": false,
          "includeAll": false
        },
        {
          "name": "pod",
          "label": "Pod",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "cfkr3kwq69r7ke"
          },
          "query": {
            "query": "label_values(up{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\"}, pod)",
            "refId": "PodVariableQuery"
          },
          "refresh": 1,
          "sort": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": []
        }
      ]
    },
    "links": [
      {
        "type": "link",
        "title": "PKE / Overview",
        "url": "/d/pke-overview?var-cluster=${cluster}",
        "includeVars": false,
        "keepTime": true,
        "targetBlank": false
      },
      {
        "type": "link",
        "title": "Keycloak PostgreSQL",
        "url": "/d/cloudnative-pg?var-cluster=${cluster}&var-namespace=keycloak&var-cnpg_cluster=keycloak-cluster",
        "includeVars": false,
        "keepTime": true,
        "targetBlank": true
      }
    ],
    "panels": [
      {
        "id": 1,
        "title": "収集状態",
        "description": "選択Podのupの最小値。120秒より古い系列は未取得とし、scrape成功をログイン成功とは扱わない。",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "min(up{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\"} and (time() - timestamp(up{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\"}) < 120))",
            "legendFormat": "Scrape",
            "range": false,
            "editorMode": "code",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "収集失敗",
                    "color": "red"
                  },
                  "1": {
                    "text": "収集中",
                    "color": "green"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 2,
        "title": "起動からの時間",
        "description": "複数Pod選択時は最も短い稼働時間。再起動やPod置換の確認に使う。",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "min(process_uptime_seconds{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\"})",
            "legendFormat": "Uptime",
            "range": false,
            "editorMode": "code",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 3,
        "title": "HTTPリクエスト",
        "description": "healthとmetricsを除く全HTTP要求。管理APIも含み、認証成功数ではない。",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri!~\"/health/.*|/metrics\"}[$__rate_interval]))",
            "legendFormat": "Requests",
            "range": false,
            "editorMode": "code",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 4,
        "title": "HTTP 4xx",
        "description": "DCRや認可の拒否、無効な入力など。全HTTP系列が欠測の場合は0に補完しない。",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri!~\"/health/.*|/metrics\",status=~\"4..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri!~\"/health/.*|/metrics\"}[$__rate_interval]))))",
            "legendFormat": "4xx",
            "range": false,
            "editorMode": "code",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 5,
        "title": "HTTP 5xx",
        "description": "Keycloakのサーバーエラー。全HTTP系列が欠測の場合は0に補完しない。",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri!~\"/health/.*|/metrics\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri!~\"/health/.*|/metrics\"}[$__rate_interval]))))",
            "legendFormat": "5xx",
            "range": false,
            "editorMode": "code",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 6,
        "title": "DB接続待ち",
        "description": "Agroalで接続取得を待っている要求数。継続して増える場合は下段の接続プールとDB詳細を確認する。",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 20,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(agroal_awaiting_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\"})",
            "legendFormat": "Waiting",
            "range": false,
            "editorMode": "code",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      },
      {
        "id": 7,
        "title": "HTTP応答コード別の要求",
        "description": "healthとmetricsを除く。4xxの増加は下のDCR・tokenとイベントログで切り分ける。",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (status) (rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri!~\"/health/.*|/metrics\"}[$__rate_interval]))",
            "legendFormat": "{{status}}",
            "range": true,
            "editorMode": "code"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 8,
              "showPoints": "never",
              "spanNulls": false,
              "axisCenteredZero": false,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 8,
        "title": "認証・DCRの平均応答時間",
        "description": "認可・token・DCR・ログイン処理のsum/countによる平均値。HTTP bucket未収集のためp95ではない。対象区間に要求がない経路は表示しない。",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri=~\"/realms/.*/(protocol/[^/]+/(auth|token)|clients-registrations/[^/]+|login-actions/(authenticate|consent))\"}[$__rate_interval])) / (sum by (uri) (rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri=~\"/realms/.*/(protocol/[^/]+/(auth|token)|clients-registrations/[^/]+|login-actions/(authenticate|consent))\"}[$__rate_interval])) > 0)",
            "legendFormat": "{{uri}}",
            "range": true,
            "editorMode": "code"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "noValue": "未取得",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "fillOpacity": 8,
              "showPoints": "never",
              "spanNulls": false,
              "axisCenteredZero": false,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 9,
        "title": "DCR登録・更新",
        "description": "匿名登録と登録済みクライアントの更新・取得を含む。400/403の理由はイベントログで確認する。",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (method, status) (rate(http_server_requests_seconds_count{cluster=\"$cluster\",namespace=\"keycloak\",container=\"keycloak\",pod=~\"$pod\",uri=~\"/realms/.*/clients-registrations/.*\"}[$__rate_interval]))",
            "legendFormat": "{{method}} {{status}}",
            "range": true,
            "editorMode": "code"
          }
        ],
        "fieldConfig": {
          "defaults": {
