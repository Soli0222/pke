      },
      {
        "id": 12,
        "title": "JVMプロセスCPU使用率",
        "description": "process_cpu_usageの0〜1値。ホストCPU容量に対する割合で、CPUコア数ではない。",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "cfkr3kwq69r7ke"
        },
        "gridPos": {
          "x": 12,
